{
  "name": "balancevault",
  "version": "1.0.0",
  "description": "BalanceVault (formerly LedgerLine) — High-Integrity Financial Ledger & Double-Entry Accounting Engine",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "node scripts/start-prod.js",
    "build:client": "npm run build --prefix client",
    "build": "npm run build --prefix client",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "bootstrap:admin": "node scripts/bootstrap-admin.js",
    "bootstrap": "node scripts/bootstrap-admin.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "test": "vitest run",
    "mutation": "node scripts/mutation-check.js",
    "attack": "node scripts/attack.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "embedded-postgres": "16.15.0-beta.19",
    "prisma": "^6.19.3",
    "puppeteer-core": "^25.16.0",
    "supertest": "^7.0.0",
    "vitest": "^3.0.7"
  }
}
