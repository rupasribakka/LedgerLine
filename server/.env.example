# LedgerLine Backend Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection URL (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ledgerline?schema=public

# Authentication Security (Phase 2)
JWT_SECRET=ledgerline_dev_secret_key_change_in_production_32chars
JWT_EXPIRES_IN=24h
