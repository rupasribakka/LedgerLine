// Prisma Schema for LedgerLine
// Secure Financial Transaction and Double-Entry Ledger Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// Architectural Model Outline (To be finalized & migrated in Phase 2)
// =========================================================================
//
// 1. User
//    - id, email, passwordHash, role (ADMINISTRATOR, ACCOUNT_HOLDER, AUDITOR), createdAt
//
// 2. Account
//    - id, accountNumber, userId, balancePaise (BigInt / Int), currency, status, createdAt
//    * Strict rule: balance stored in integer paise.
//
// 3. Transaction
//    - id, idempotencyKey (Unique), type (DEPOSIT, WITHDRAWAL, TRANSFER),
//      amountPaise, status (PENDING, POSTED, REJECTED), createdAt
//
// 4. LedgerEntry (Double-entry journal: debits and credits)
//    - id, transactionId, accountId, entryType (DEBIT, CREDIT),
//      amountPaise, balanceAfterPaise, createdAt
//    * Strict rule: Append-only. No UPDATE or DELETE permitted.
//
// 5. AuditLog
//    - id, userId, action, ipAddress, userAgent, status (SUCCESS, REJECTED),
//      reason, createdAt
// =========================================================================
