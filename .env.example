PORT=5000
NODE_ENV=development
JWT_SECRET=
DATABASE_URL=
# Required in production. Use a separate schema-owner/migration role.
MIGRATION_DATABASE_URL=
# Local embedded PostgreSQL is optional; use a private value only in your ignored .env file.
LEDGERLINE_EMBEDDED_DB_PASSWORD=
# Demo users are created only when explicitly enabled outside production.
LEDGERLINE_SEED_DEMO_USERS=false

# Redis Configuration (Optional: automatically falls back to in-memory sliding window if omitted)
REDIS_URL=redis://localhost:6379

# First-Admin Bootstrap Credentials
FIRST_ADMIN_EMAIL=admin@balancevault.local
FIRST_ADMIN_PASSWORD=AdminPassword123!
FIRST_ADMIN_NAME="System Administrator"
